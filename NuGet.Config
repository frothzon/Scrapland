<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Drop inherited machine sources so restores are reproducible on this machine. -->
    <clear />
    <!--
      GodotSharp / Godot.NET.Sdk / Godot.SourceGenerators 4.7.2 ship inside the local Godot
      mono build. Keeping this source first makes restores work offline and guarantees the
      engine and the SDK can never drift apart (see lessons_learned.md LL-004).
      The path is relative to this file.
    -->
    <add key="godot-local" value="Godot_v4.7.2-stable_mono_win64\GodotSharp\Tools\nupkgs" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
